import numpy as np
import matplotlib.pyplot as plt

# Datos
x = np.array([0, 2, 4, 6, 8])   # Posición (cm)
y = np.array([100, 92, 85, 78, 71])  # Temperatura (°C)

# Cálculo de coeficientes
n = len(x)
sum_x, sum_y = np.sum(x), np.sum(y)
sum_xy, sum_x2 = np.sum(x*y), np.sum(x**2)

b = (n*sum_xy - sum_x*sum_y) / (n*sum_x2 - sum_x**2)
a = (sum_y - b*sum_x) / n

print(f"a (intercepto) = {a:.4f}")
print(f"b (pendiente) = {b:.4f}")

# Predicción en x=5
x_eval = 5
y_eval = a + b*x_eval
print(f"Temperatura estimada en x=5 cm: {y_eval:.2f} °C")

# Gráfica
y_pred = a + b*x
plt.plot(x, y, 'o', label="Datos")
plt.plot(x, y_pred, '-', color="red", label=f"Ajuste: y = {a:.2f} + {b:.2f}x")
plt.xlabel("Posición (cm)")
plt.ylabel("Temperatura (°C)")
plt.title("Regresión lineal - Transferencia de calor")
plt.legend()
plt.grid(True)
plt.show()
